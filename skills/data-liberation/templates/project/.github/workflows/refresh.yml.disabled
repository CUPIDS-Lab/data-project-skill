# Opt-in: rename to refresh.yml once the pipeline runs cleanly by hand.
#
# Runs the whole pipeline on a schedule and opens a pull request when anything
# changed. The PR carries the data diff and the audit diff (data/audit/*.md and
# headline.json are committed; see .gitignore), so review happens before merge.
# If any stage fails (no rows, rows lost between stages, a fetch error) the job
# fails and no PR opens: you get a failed-run notification instead of bad data.
#
# Scheduled runs can start late or be skipped. For a source that only shows the
# current day's records, add a second cron a few hours later and check
# data/audit/discovery.md for gaps; a missed capture cannot be backfilled.

name: refresh

on:
  schedule:
    - cron: "17 13 * * 1" # Mondays 13:17 UTC; trail the publisher's own cadence
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: refresh
  cancel-in-progress: false

jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          lfs: true # only needed when originals are LFS-tracked (storage budget)

      - uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
          python-version: "3.13"

      - name: Install (add the extras the parsers need, e.g. --extra pdf)
        run: uv sync

      - name: Run the pipeline
        run: uv run python -m scripts.pipeline run --quiet

      - name: Open a pull request with the refreshed data
        uses: peter-evans/create-pull-request@v8
        with:
          branch: refresh/scheduled
          commit-message: "Scheduled data refresh"
          title: "Scheduled data refresh"
          body: |
            Scheduled refresh from `.github/workflows/refresh.yml`. Before merging, check in the diff:

            - [ ] `data/audit/summary.md`: the row change is plausible; the error count and rejected rows are explained.
            - [ ] `data/audit/reconcile.md` (if present): no new mismatch.
            - [ ] `data/original/manifest.json`: any changed sha256 is an expected upstream revision.
            - [ ] The spot-check sample in the summary matches the originals.
            - [ ] `CHANGELOG.md` has an entry if a published number changed.
          add-paths: |
            data/original/**
            data/processed/*.csv
            data/audit/*.md
            data/audit/headline.json
            docs/variables.md
            docs/variables.csv
            README.md
            AGENTS.md
