[project]
name = "{{PROJECT_SLUG}}"
version = "0.1.0"
description = "{{DESCRIPTION}}"
authors = [{name = "{{AUTHOR}}"}]
requires-python = ">=3.12"
readme = "README.md"
license = "MIT"
dependencies = [
    "pandas>=2.2",
    "pyarrow>=15",
    "pandera[pandas]>=0.24",  # 0.24 is the first release with `pandera.pandas`
    "pyyaml>=6",
    "requests>=2.32",
    "requests-cache>=1.2",
    "tenacity>=8",
    "tabulate>=0.9",  # DataFrame.to_markdown for the audit reports
]

# Install only the extras the source needs: `uv sync --extra pdf`.
[project.optional-dependencies]
pdf = [
    "pypdfium2>=4.30",  # the default text layer: one self-contained wheel
    "pdfplumber>=0.11",  # positioned words and simple ruled tables
    "camelot-py>=1.0",  # ruled (lattice) and whitespace (stream) tables; no [cv] extra needed
]
ocr = [
    "pytesseract>=0.3.10",  # needs the tesseract binary; pypdfium2 renders the page images
    "pypdfium2>=4.30",
]
scrape = [
    "httpx>=0.27",
    "selectolax>=0.3.21",
    "playwright>=1.45",  # then once: `uv run playwright install chromium`
]
tabular = [
    "openpyxl>=3.1",
    "xlrd>=2.0",
    "pyreadstat>=1.2",
]
analysis = [
    "duckdb>=1.0",  # SQL over the processed CSV (docs/filter-pivot-recipes.md)
]
# Publishing (Outline section 8) only: Datasette and DocumentCloud.
publish = [
    "datasette>=0.65",
    "sqlite-utils>=3.36",
    "datasette-publish-vercel>=0.14",
]
documentcloud = [
    "python-documentcloud>=4.0",
]

[dependency-groups]
dev = [
    "pytest>=8",
    "ruff==0.17.2",  # one pinned version, so `ruff format --check` agrees everywhere
    "mypy>=1.11",
    "nbstripout>=0.8",  # `uv run nbstripout --install` once per clone if you use notebooks
]

[project.scripts]
{{PROJECT_SLUG}} = "scripts.pipeline:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["scripts"]

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "I", "W", "B", "UP"]
ignore = ["E501"]

[tool.ruff.lint.isort]
known-first-party = ["scripts"]

[tool.pytest.ini_options]
testpaths = ["tests"]
