"""Paths, HTTP defaults, and the identity of this project's source.

The project starts with one source. Its slug, label and license live here as
constants, and `scripts/source.py` says what to fetch and how to parse it. When a
second source arrives, follow "Adding a second source" in the data-liberation
skill's `project-template.md`: that is when a source registry earns its place.
"""

from __future__ import annotations

import os
from pathlib import Path

# ─── Paths ──────────────────────────────────────────────────────────────────

ROOT = Path(__file__).resolve().parent.parent

# Long runs: set {{PKG_NAME}} in upper case + _DATA_DIR (DATA_DIR_ENV below) to a copy
# of data/ outside the working tree. The run writes there, nothing half-finished lands
# in the repository, and you copy the result back and commit once (AGENTS.md, "Long
# runs"). Unset, the project's own data/ is used.
DATA_DIR_ENV = "{{PKG_NAME}}".upper() + "_DATA_DIR"
DATA = Path(os.environ.get(DATA_DIR_ENV, ROOT / "data")).resolve()
DATA_ORIGINAL = DATA / "original"  # immutable: written only by fetch.py
DATA_PROCESSED = DATA / "processed"  # the dataset and its provenance sidecar
DATA_AUDIT = DATA / "audit"  # generated reports and per-run logs
DATA_LOOKUPS = DATA / "lookups"  # hand-kept tables (vocabularies, crosswalks)
DOCS = ROOT / "docs"

for _p in (DATA_ORIGINAL, DATA_PROCESSED, DATA_AUDIT, DATA_LOOKUPS, DOCS):
    _p.mkdir(parents=True, exist_ok=True)


def display_path(path: Path | str) -> Path:
    """A path to show people: repository-relative, or data/... when DATA is a copy.

    Use it for every path printed or written into a report. `path.relative_to(ROOT)`
    raises for files under a data directory outside the repository.
    """
    path = Path(path).resolve()
    try:
        return path.relative_to(ROOT)
    except ValueError:
        try:
            return Path("data") / path.relative_to(DATA)
        except ValueError:
            return path


# The dataset. File stems use the import-safe name so SQL engines need no quoting.
PROCESSED_CSV = DATA_PROCESSED / "{{PKG_NAME}}.csv"
PROCESSED_PARQUET = DATA_PROCESSED / "{{PKG_NAME}}.parquet"
PROCESSED_DB = DATA_PROCESSED / "{{PKG_NAME}}.db"
PROVENANCE_CSV = DATA_PROCESSED / "provenance.csv"
METADATA_YAML = DATA_PROCESSED / "metadata.yaml"

# One manifest for every original: path (relative to data/original/) → url, sha256,
# size, fetch time. Committed even when the originals themselves are not.
MANIFEST_JSON = DATA_ORIGINAL / "manifest.json"

# Audit outputs. The Markdown reports and headline.json are deterministic (no
# wall-clock time in them) and committed, so a refresh PR shows the audit diff.
# The JSON/CSV logs below are rewritten from scratch on every run and gitignored.
SUMMARY_MD = DATA_AUDIT / "summary.md"
HEADLINE_JSON = DATA_AUDIT / "headline.json"
RECONCILE_MD = DATA_AUDIT / "reconcile.md"
RECONCILE_JSON = DATA_AUDIT / "reconcile.json"
FETCH_ERRORS_JSON = DATA_AUDIT / "fetch_errors.json"
EXTRACTION_ERRORS_JSON = DATA_AUDIT / "extraction_errors.json"
REJECTED_CSV = DATA_AUDIT / "rejected.csv"
RUN_JSON = DATA_AUDIT / "run.json"  # run metadata: timestamps and the row ledger

# Docs that carry generated numbers between <!-- BEGIN generated:headline --> and
# <!-- END generated --> markers. `audit` rewrites them; a test fails when stale.
GENERATED_DOCS = [ROOT / "README.md", ROOT / "AGENTS.md"]

# ─── The source ─────────────────────────────────────────────────────────────

# Short, stable slug: it names data/original/<slug>/ and fills the `source` column.
SOURCE_SLUG = "example_source"
SOURCE_LABEL = "Replace with the publisher and the series name"
# The publisher's terms, as found in its terms of use, metadata or records response.
SOURCE_LICENSE = "unknown: record the publisher's terms before sharing the data"
# Does the publisher print totals or subtotals the data can be checked against? When
# True, `reconcile` fails until a reconciler is registered in scripts/reconcile.py.
SOURCE_PRINTS_TOTALS = False

# ─── HTTP defaults ──────────────────────────────────────────────────────────

USER_AGENT = (
    "{{PROJECT_SLUG}}/0.1 (+https://github.com/{{OWNER}}/{{PROJECT_SLUG}}; "
    "edit the contact in scripts/config.py)"
)
REQUEST_TIMEOUT_S = 60
CACHE_PATH = ROOT / ".requests-cache.sqlite"
CACHE_EXPIRE_S = 24 * 3600  # shorten for publishers that revise files often
